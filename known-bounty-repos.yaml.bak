# Opportunity Radar - 已知赏金仓库热区表
# 这些仓库已知会发布赏金/付费 issue，每日主动扫描
# 来源：Algora, IssueHunt, OnlyDust, GitHub bounty 标签, 人工验证
# 更新时间：2026-05-14 13:00 (热区扩展 +4)

known_bounty_repos:
  # ==================== TypeScript / JavaScript ====================

  # Expensify - 最大开源赏金项目之一，使用 "External" 标签，月赏金 $50k+
  - repo: Expensify/App
    language: typescript
    labels: ["External", "Help Wanted", "Bug"]
    bounty_source: "expensify-external"
    expected_bounty_range: [50, 10000]
    tags: ["high-volume", "daily", "proven-payer"]
    notes: "使用 'External' 标签，标题中含 [$X] 金额"

  # tscircuit 系列 - 通过 Algora 平台发放赏金
  - repo: tscircuit/schematic-trace-solver
    language: typescript
    labels: ["💎 Bounty", "$100"]
    bounty_source: "algora"
    expected_bounty_range: [50, 500]
    tags: ["algora", "proven-payer"]
    notes: "使用 '💎 Bounty' 和 '$100' 标签标记赏金"

  - repo: tscircuit/tscircuit-autorouter
    language: typescript
    labels: ["💎 Bounty", "$100"]
    bounty_source: "algora"
    expected_bounty_range: [50, 500]
    tags: ["algora", "proven-payer"]
    notes: "活跃的自动化布线项目，Algora 赏金"

  - repo: tscircuit/core
